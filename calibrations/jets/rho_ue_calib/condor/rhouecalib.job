# Rho UE calibration, one job per line of the todo list of make_todo.sh / make_todo_files.sh.
# Submit from this directory, one step at a time; each step needs the merged output of the one
# before (merge.sh <step> <dir> between the steps; run_chain.sh does all of it):
#   condor_submit rhouecalib.job step=knee todo=<listdir>/todo.txt outdir=<dir>
#   condor_submit rhouecalib.job step=smap todo=<listdir>/todo.txt outdir=<dir> knee=<dir>/knee.txt
#   condor_submit rhouecalib.job step=ue   todo=<listdir>/todo.txt outdir=<dir> knee=<dir>/knee.txt smap=<dir>/smap_payload.root
# Make the log directory first: mkdir -p <dir>/logs/<step> (condor does not create it).
# Optional variables (defaults in the Arguments line): cdbtag=<tag>; setup=<script to source>
# (e.g. a setup with a local build of rhouecalib / jetbackground); macro=Fun4All_RhoUECalib_Sim.C
# for HIJING; seedeta=<|eta| max of the seed jets> (default "window" = the tower eta range shrunk by R; 5 = every jet);
# zslist=<ZS cross-calibration list of make_zs_crosscalib_list.C> for runs without their own payload
# (default: the run's own CDB payload, the calorimeter calibration aborts without it), or zslist=off.
# centdir=<directory of the simulation centrality scales> for HIJING (default: the CDB tag's).
# Paths must be absolute. Without smap= the "ue" step makes the calibration for rho without the s-map.
macro_dir      = $ENV(PWD)/..
Universe       = vanilla
Executable     = $ENV(PWD)/run_rhouecalib.sh
request_memory = 3GB
batch_name     = rhouecalib_$(step)
Output         = $(outdir)/logs/$(step)/$(run)_$(seg).out
Error          = $(outdir)/logs/$(step)/$(run)_$(seg).err
Log            = /tmp/condorjob-$ENV(USER).log
Arguments      = "$(step) $(list) $(outdir)/$(step)/$(step)_$(run)_$(seg).root $(cdbtag:newcdbtag) $(knee:none) $(smap:none) $(setup:none) $(macro_dir) $(macro:Fun4All_RhoUECalib.C) $(seedeta:window) $(zslist:none) $(centdir:none)"
Queue run, seg, list from $(todo)
